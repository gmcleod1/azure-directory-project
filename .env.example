# Copy this file to `.env` (which is gitignored) and fill in real values.
# Generate strong values with:  openssl rand -base64 24
# Or in PowerShell:              -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | %{[char]$_})

# MariaDB root password (used only for container init / break-glass)
MARIADB_ROOT_PASSWORD=replace-me-strong-root-password

# osTicket application DB password
MARIADB_PASSWORD=replace-me-strong-app-password

# osTicket install secret (any 16+ char random string)
INSTALL_SECRET=replace-me-random-install-secret
